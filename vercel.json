{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "api": {
      "entrypoint": "backend/server.js",
      "framework": "express",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/records", "destination": "/backend/server.js" },
    { "source": "/records/:path*", "destination": "/backend/server.js" },
    { "source": "/records-summary/:path*", "destination": "/backend/server.js" },
    { "source": "/sizo-summary/:path*", "destination": "/backend/server.js" },
    { "source": "/sizo-image", "destination": "/backend/server.js" },
    { "source": "/sizo-image/:path*", "destination": "/backend/server.js" },
    { "source": "/photos", "destination": "/backend/server.js" }
  ]
}
